# Copie para .env e ajuste. Nunca versione o .env real.
DB_USER=jane
DB_PASSWORD=troque-esta-senha
DB_NAME=jane
DB_PORT=5439
DATABASE_URL=postgres://jane:troque-esta-senha@127.0.0.1:5439/jane

PORT=3001
NODE_ENV=development
# Origem do frontend em desenvolvimento (CORS desativado em produção: mesma origem)
WEB_ORIGIN=http://localhost:5173
# Em produção atrás de HTTPS: cookie Secure
COOKIE_SECURE=false
SESSION_HOURS=8

# Backups: usa pg_dump se disponível (opcional; sem ele o sistema gera o dump sozinho). Em dev com Docker:
#   PG_DUMP_CMD=docker exec -i jane-db pg_dump -U jane -d jane
# Em produção com cliente instalado, deixe vazio para usar pg_dump com DATABASE_URL.
PG_DUMP_CMD=
BACKUP_DIR=./storage/backups
# Backup automático a cada N horas (0 = desligado) e quantos manter
BACKUP_AUTO_HOURS=0
BACKUP_KEEP=14
UPLOAD_DIR=./storage/uploads
