# Copie para .env e ajuste. Nunca versione o .env real.
DB_USER=jane
DB_PASSWORD=troque-esta-senha
DB_NAME=jane
DB_PORT=5439
DATABASE_URL=postgres://jane:troque-esta-senha@127.0.0.1:5439/jane

PORT=3001
NODE_ENV=development
# Origem do frontend em desenvolvimento (CORS desativado em produção: mesma origem)
WEB_ORIGIN=http://localhost:5173
# Em produção atrás de HTTPS: cookie Secure
COOKIE_SECURE=false
SESSION_HOURS=8

# Backups: usa pg_dump se disponível (opcional; sem ele o sistema gera o dump sozinho). Em dev com Docker:
#   PG_DUMP_CMD=docker exec -i jane-db pg_dump -U jane -d jane
# Em produção com cliente instalado, deixe vazio para usar pg_dump com DATABASE_URL.
PG_DUMP_CMD=
BACKUP_DIR=./storage/backups
# Backup automático a cada N horas (0 = desligado) e quantos manter
BACKUP_AUTO_HOURS=0
BACKUP_KEEP=14
UPLOAD_DIR=./storage/uploads

# E-mail (recuperação de senha). Sem SMTP_HOST, fora de produção, o e-mail é apenas impresso no console.
# Gmail: ative a verificação em duas etapas e crie uma "senha de app" (conta Google > Segurança > Senhas de app).
# Use a senha de app de 16 caracteres em SMTP_PASS, nunca a senha normal da conta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=seu.endereco@gmail.com
# SMTP_PASS=
# SMTP_FROM="Gentis <seu.endereco@gmail.com>"
# Endereço público do sistema usado nos links dos e-mails (padrão: WEB_ORIGIN)
# APP_URL=https://gentis.exemplo.com.br

# Assistente de IA (Google Gemini). Sem GEMINI_API_KEY o assistente fica indisponível.
# Atenção: no plano gratuito do Gemini a Google pode usar os dados enviados para melhorar seus produtos;
# com dados reais use um projeto com faturamento ativado (plano pago).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash
# AI_DAILY_MESSAGES=40          # perguntas por usuário por dia
# AI_MONTHLY_TOKENS=3000000     # tokens (entrada + saída) de todos os usuários por mês
